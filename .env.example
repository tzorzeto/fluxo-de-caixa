# Valores de DESENVOLVIMENTO: funcionam com `cp .env.example .env` sem editar nada.
# Em qualquer ambiente fora da máquina local, troque todos os segredos e use um cofre.

# PostgreSQL (o docker-compose cria o banco com estes valores)
PGUSER=usercarrefour
PGPASSWORD=875421
PGDATABASE=bancocarrefour
PGHOST=db
PGPORT=5432

# RabbitMQ (usuário admin/admin definido no docker-compose)
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672

# Aplicação
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=8h
ADMIN_TOKEN=dev-admin-token
TZ=America/Sao_Paulo
DIAS_RETROATIVOS=30
PORT=3000
